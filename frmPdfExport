'---------------------- 内部処理 ------------------------------

Private Sub LoadSheets()
    Dim ws As Worksheet
    Dim cur As String: cur = Trim$(cboSheet.Value)

    cboSheet.Clear
    For Each ws In ThisWorkbook.Worksheets
        ' グラフシート等を除きたい場合は TypeName(ws)="Worksheet" をチェック
        cboSheet.AddItem ws.Name
    Next ws

    ' 以前の選択がまだ存在すれば戻す
    Dim i As Long
    For i = 0 To cboSheet.ListCount - 1
        If StrComp(cboSheet.List(i), cur, vbTextCompare) = 0 Then
            cboSheet.ListIndex = i
            Exit For
        End If
    Next i

    If cboSheet.ListCount > 0 And cboSheet.ListIndex < 0 Then
        cboSheet.ListIndex = 0
    End If

    Call ShowPageInfo
End Sub

Private Sub ShowPageInfo()
    On Error Resume Next
    Dim sh As String: sh = Trim$(cboSheet.Value)
    If Len(sh) = 0 Then
        lblInfo.Caption = ""
        Exit Sub
    End If

    Dim n As Long
    n = modPdfExport.推定ページ数(sh)
    If n > 0 Then
        lblInfo.Caption = "推定ページ数: " & n & "（印刷範囲・倍率・改ページに依存）"
    Else
        lblInfo.Caption = "推定ページ数を算出できませんでした。"
    End If
End Sub
Private Sub frmPdfExport_Initialize()
    ' === フォームサイズの固定 ===
    With Me
        .StartUpPosition = 1          ' 1 = CenterOwner（中央表示）
        .Zoom = 100                   ' ズーム倍率を固定（これが変動の原因になる）
        .Width = 600                  ' 横幅
        .Height = 350                 ' 高さ
    End With

    ' --- 以下は既存の初期化処理 ---
    Call LoadSheets
    chkAll.Value = True
    txtFrom.Enabled = False
    txtTo.Enabled = False
    lblInfo.Caption = ""

    Dim last As String
    last = GetSetting("PdfExport", "Settings", "OutDir", "")
    If Len(last) = 0 Then last = Environ$("USERPROFILE") & "\Desktop"
    txtOutDir.Text = last
End Sub

